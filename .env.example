OPENAI_API_KEY=sk-your-api-key

# Optional. Use this when calling an OpenAI-compatible proxy.
# Examples:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://your-provider.example.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# The Tencent Cloud article references gpt-image-2. If your provider does not
# support it, try gpt-image-1.5, gpt-image-1, or another model it documents.
GPT_IMAGE_MODEL=gpt-image-2
